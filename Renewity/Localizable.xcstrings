        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Test von „%@“ endet in %lld Tagen, danach werden %@ abgebucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The trial for “%@” ends in %lld days, then you’ll be charged %@."
          }
