    "暂停后不再按期扣费，也不会发送提醒。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Pause-Status gibt es keine fällige Abbuchung und keine Erinnerungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While paused, it won’t count as a charge and reminders won’t be sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa no se cuenta un cobro ni se envían recordatorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause, aucun prélèvement ni rappel n’est prévu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa non risultano addebiti e non partono promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止中は請求もリマインダーも行われません。"
