    "将根据最近一次扣费日和计费周期，自动推算下次扣费为 %@。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus letztem Abbuchungsdatum und Zyklus ergibt sich die nächste Abbuchung am %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next charge is calculated from the last charge date and billing cycle as %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según el último cargo y el ciclo, el próximo cargo es el %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’après la dernière date et la périodicité, le prochain prélèvement est le %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In base all’ultimo addebito e al ciclo, il prossimo è il %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の請求日とサイクルから、次回請求は %@ と計算されます。"
