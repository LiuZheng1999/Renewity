    "试用持续到下次扣费日，当天开始按上面的费用扣款。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Testphase läuft bis zum nächsten Abbuchungstag. Ab dann gilt der Betrag oben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The trial lasts until the next charge date. Billing at the amount above starts that day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba dura hasta la próxima fecha de cobro; ese día empieza el importe de arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’essai dure jusqu’à la prochaine date de prélèvement, qui démarre le tarif ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prova dura fino alla prossima data di addebito; da quel giorno vale l’importo sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料期間は次回請求日までです。その日から上記の料金が請求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체험은 다음 결제일까지이며, 당일부터 위 금액이 청구됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
