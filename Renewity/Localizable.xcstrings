        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 결제일과 주기를 기준으로 다음 결제는 %@입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com base na última cobrança e no ciclo, a próxima é em %@."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將根據最近一次扣款日和計費週期，自動推算下次扣款為 %@。"
          }
        }
      }
    },
    "将用 iCloud 备份覆盖现有订阅、自定义分类和自定义支付方式，此操作无法撤销。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iCloud-Backup ersetzt aktuelle Abos, eigene Kategorien und Zahlungsmethoden. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This replaces your current subscriptions, custom categories, and custom payment methods with the iCloud backup. This can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de iCloud sustituirá tus suscripciones, categorías y métodos de pago personalizados. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde iCloud remplacera vos abonnements, catégories et moyens de paiement personnalisés. Action irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup iCloud sostituirà abbonamenti, categorie e metodi di pagamento personalizzati. L’operazione non è reversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud バックアップで現在のサブスク、カスタムカテゴリ、カスタム支払い方法を上書きします。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 백업으로 현재 구독, 사용자 지정 분류, 사용자 지정 결제 수단을 덮어씁니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O backup do iCloud substituirá assinaturas, categorias e formas de pagamento personalizadas. Isso não pode ser desfeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将用 iCloud 备份覆盖现有订阅、自定义分类和自定义支付方式，此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將用 iCloud 備份覆蓋現有訂閱、自訂分類和自訂支付方式，此操作無法復原。"
          }
        }
      }
    },
