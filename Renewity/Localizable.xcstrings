    "iCloud 不可用，请在系统设置中登录 Apple 账户并打开 iCloud Drive。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist nicht verfügbar. Melde dich in den Einstellungen mit deinem Apple Account an und aktiviere iCloud Drive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud isn’t available. Sign in with your Apple Account in Settings and turn on iCloud Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no está disponible. Inicia sesión con tu cuenta de Apple en Ajustes y activa iCloud Drive."
